# ===== Môi trường =====
NODE_ENV=development

# ===== URL =====
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Port backend chạy (nên khớp với BACKEND_URL)
PORT=4000

# ===== PostgreSQL =====
# Định dạng: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DB_POSTGRES=postgresql://postgres:postgres@localhost:5432/app_dev

# ===== Frontend (Vite chỉ đọc biến có prefix VITE_) =====
VITE_API_URL=http://localhost:4000
